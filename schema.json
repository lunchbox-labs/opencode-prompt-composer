{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenCode Prompt Composer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prepend": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 256
        },
        "append": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 256
        }
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prepend": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 256
          },
          "append": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 256
          },
          "inheritDefaults": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
