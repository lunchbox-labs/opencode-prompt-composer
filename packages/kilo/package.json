{
  "name": "@lunchbox-labs/kilo-prompt-composer",
  "version": "0.3.0",
  "description": "Compose reusable prompt text in native Kilo CLI agents, commands and on-demand skills",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunchbox-labs/opencode-prompt-composer.git",
    "directory": "packages/kilo"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./includes": {
      "types": "./dist/includes.d.ts",
      "default": "./dist/includes.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "docs/examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lunchbox-labs/prompt-composer-core": "0.3.0"
  },
  "devDependencies": {
    "@kilocode/plugin": "7.8.27",
    "@kilocode/sdk": "7.8.27",
    "@opentui/core": "0.5.11",
    "@opentui/keymap": "0.5.11",
    "@opentui/solid": "0.5.11",
    "solid-js": "1.9.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
