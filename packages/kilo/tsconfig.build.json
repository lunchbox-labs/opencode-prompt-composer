{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@lunchbox-labs/prompt-composer-core/*": ["../core/dist/*"],
      "@opentui/*": ["./node_modules/@opentui/*"],
      "@opentui/keymap/extras": [
        "./node_modules/@opentui/keymap/src/extras/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"]
}
