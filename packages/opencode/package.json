{
  "name": "@lunchbox-labs/opencode-prompt-composer",
  "version": "0.3.0",
  "description": "Compose reusable prompt text in native OpenCode agents, commands and on-demand skills",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunchbox-labs/prompt-composer-plugin.git",
    "directory": "packages/opencode"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./includes": {
      "types": "./dist/includes.d.ts",
      "default": "./dist/includes.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "docs/examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@opencode-ai/sdk": "1.19.5",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
